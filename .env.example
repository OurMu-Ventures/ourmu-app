NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
IDENTITY_MASTER_KEY_BASE64=replace-with-32-byte-base64-value
CRON_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=
RESEND_FROM_EMAIL=OURMU <no-reply@auth.ourmu.org>
ALLOW_MANUAL_TEST_LINKS=false
LEGAL_PRIVACY_VERSION=2026-09-09
AGREEMENT_PLACEHOLDER_BLOCK=true

# Optional newsletter contact inbox; set personal addresses only in server configuration.
NEWSLETTER_CONTACT_EMAIL=community@ourmu.org

# Optional, production only: bearer for the Supabase Cron dispatcher (same value as the Vault
# secret ourmu_job_trigger_secret). Leave empty locally; values under 32 characters are ignored.
JOB_TRIGGER_SECRET=

# Enable additional investment account creation only after the account migration and review.
MULTIPLE_INVESTMENT_ACCOUNTS_ENABLED=false

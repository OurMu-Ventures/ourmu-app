# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Supabase state and generated agreements
/supabase/.branches
/supabase/.temp
/artifacts

# legacy/local services
/backend

# private imports, exports, database backups, and generated manifests
*.csv
*.tsv
*.xls
*.xlsx
*.dump
*.dump.*
*.backup
*.age
*.manifest.json
*.sql.gz

# private keys and certificates
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
age-identity.txt
